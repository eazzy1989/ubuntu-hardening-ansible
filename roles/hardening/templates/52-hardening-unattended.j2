// {{ ansible_managed }}
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if hardening_unattended_reboot else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ hardening_unattended_reboot_time }}";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
